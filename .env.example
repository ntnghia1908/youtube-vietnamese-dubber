# YouTube Vietnamese Dubber - biến môi trường mẫu.
# Copy file này thành `.env` và điền giá trị thật. KHÔNG commit `.env`.
#
# Lưu ý: `.env` KHÔNG được tự nạp — đặt các biến này trong môi trường
# shell. Hiện chỉ OLLAMA_HOST được đọc (khi `translation.host` trong
# config.yaml để trống).

# --- Translation backend ---
# Chưa dùng — dành cho OpenAITranslator sau này
OPENAI_API_KEY=

# Chỉ cần nếu translation.provider = ollama và Ollama không chạy ở localhost
OLLAMA_HOST=http://localhost:11434
