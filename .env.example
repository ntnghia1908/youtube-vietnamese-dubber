# YouTube Vietnamese Dubber - biến môi trường mẫu.
# Copy file này thành `.env` và điền giá trị thật. KHÔNG commit `.env`.
#
# Lưu ý: ở Checkpoint 0 (project skeleton), CHƯA có code nào đọc các
# biến dưới đây. Đây là placeholder cho các checkpoint dịch thuật/TTS
# sau này (xem docs/IMPLEMENTATION_PLAN.md, mục "Translation" và "TTS").

# --- Translation backend ---
# Chỉ cần nếu translation.provider = openai (ưu tiên Ollama local, miễn phí)
OPENAI_API_KEY=

# Chỉ cần nếu translation.provider = ollama và Ollama không chạy ở localhost
OLLAMA_HOST=http://localhost:11434
